{
  "name": "dsh-tool-defiriskeng",
  "version": "0.1.0",
  "description": "DeFi Risk Engineering Toolkit for DeepSeek Harness - Protocol risk scoring, flash loan attack detection, TVL health monitoring, oracle manipulation detection, impermanent loss calculation, smart contract vulnerability scanning, governance attack analysis, and DeFi portfolio risk management",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-defiriskeng.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "defi",
    "risk",
    "risk-engineering",
    "protocol-risk",
    "flash-loan",
    "tvl",
    "oracle",
    "impermanent-loss",
    "smart-contract",
    "governance",
    "portfolio",
    "risk-management"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
