{
  "name": "dsh-tool-creativault",
  "version": "0.1.0",
  "description": "Creative Asset Intelligence & Brand Vault Toolkit for DeepSeek Harness AI-powered creative asset management, AI semantic tagging, brand compliance, visual search, version control, performance analytics, trend insights, and smart archiving — the third wave of creative democratization aligned with Adobe 2026 creative trends",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-creativault.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "creative",
    "design",
    "asset-branding",
    "asset-management",
    "brand-compliance",
    "visual-search",
    "version-control",
    "creative-insights",
    "ai-tagging",
    "design-trends",
    "purple-theme",
    "design-grid",
    "trend-visualization"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
