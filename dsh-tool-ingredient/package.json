{
  "name": "dsh-tool-ingredient",
  "version": "0.1.0",
  "description": "Ingredient Compliance Scanner for DeepSeek Harness - Regulatory compliance checking, allergen scanning, banned substance detection, nutrition analysis, cosmetic safety scoring, label compliance auditing, and alternative ingredient finding",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-ingredient.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ingredient",
    "compliance",
    "regulatory",
    "allergen",
    "food-safety",
    "cosmetic",
    "supplement",
    "nutrition",
    "label-compliance",
    "food-science",
    "regtech"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
