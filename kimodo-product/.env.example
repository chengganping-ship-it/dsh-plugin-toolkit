# Kimodo Product - 环境变量配置
# 复制此文件为 .env 并修改

# === API 服务 ===
API_HOST=0.0.0.0
API_PORT=8765

# === GUI ===
GUI_HOST=0.0.0.0
GUI_PORT=7860

# === GPU ===
CUDA_VISIBLE_DEVICES=0

# === Kimodo 模型 ===
KIMODO_MODEL_PATH=data/models/kimodo/SOMA-RP-v1.1
KIMODO_DEFAULT_SKELETON=SOMA-RP

# === 可选：whisper.cpp 语音输入 ===
WHISPER_MODEL=small
WHISPER_LANGUAGE=en

# === 可选：llama.cpp LLM 增强 ===
LLAMA_MODEL_PATH=
LLAMA_N_CTX=2048

# === 日志 ===
LOG_LEVEL=INFO
LOG_FILE=data/logs/kimodo.log

# === 速率限制 ===
RATE_LIMIT_RPM=30
