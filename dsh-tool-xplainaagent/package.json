{
  "name": "dsh-tool-xplainaagent",
  "version": "0.1.0",
  "description": "AI Agent Explainability & Transparency Toolkit for DeepSeek Harness - Decision tracing, bias detection, audit logging, compliance reporting, explainability scoring, fairness metrics, transparency reporting, and risk classification",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-xplainaagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "explainability",
    "transparency",
    "bias-detection",
    "audit",
    "compliance",
    "fairness",
    "ai-governance",
    "eu-ai-act",
    "risk-classification",
    "decision-tracing"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
