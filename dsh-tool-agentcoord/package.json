{
  "name": "dsh-tool-agentcoord",
  "version": "0.1.0",
  "description": "Multi-Agent Orchestration Coordinator for DeepSeek Harness - Task decomposition, agent capability matching, dependency graph building, consensus mechanism design, conflict resolution, progress aggregation, communication optimization, and coordination health monitoring",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-agentcoord.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multi-agent",
    "agent-coordination",
    "task-decomposition",
    "orchestration",
    "consensus",
    "conflict-resolution",
    "progress-tracking",
    "ai-agents",
    "workflow"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
