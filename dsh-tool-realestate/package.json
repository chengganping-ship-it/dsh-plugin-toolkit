{
  "name": "dsh-tool-realestate",
  "version": "0.1.0",
  "description": "Real Estate Investment Analyzer for DeepSeek Harness - Property valuation, rental yield calculation, market timing, flip analysis, portfolio optimization, mortgage analysis, location scoring, and tax benefit calculation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-realestate.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "real-estate",
    "property",
    "investment",
    "valuation",
    "rental-yield",
    "mortgage",
    "portfolio",
    "flip",
    "tax",
    "location-analysis",
    "property-management"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
