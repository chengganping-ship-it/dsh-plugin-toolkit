{
  "name": "dsh-tool-dronebot",
  "version": "0.1.0",
  "description": "Drone Fleet Management & Autonomy AI Agent for DeepSeek Harness - Fleet operations planning, airspace management, BVLOS compliance, autonomous mission design, payload optimization, battery swap scheduling, weather risk assessment, Remote ID broadcasting",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dronebot/dsh-tool-dronebot.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "drone",
    "uav",
    "fleet-management",
    "airspace",
    "bvlos",
    "autonomous",
    "utm",
    "remote-id",
    "battery-swap",
    "weather-risk"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "dronebot"
}
