{
  "name": "dsh-tool-logistics",
  "version": "0.1.0",
  "description": "Logistics & Route Optimization Engine for DeepSeek Harness - Supply chain routing, warehouse optimization, last-mile delivery planning, freight cost analysis, inventory positioning, cross-dock scheduling, fleet utilization tracking, and carbon emissions calculation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-logistics.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "logistics",
    "route-optimization",
    "warehouse-optimization",
    "last-mile-delivery",
    "freight-analysis",
    "inventory-positioning",
    "cross-dock-scheduling",
    "fleet-utilization",
    "carbon-emissions",
    "supply-chain"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
