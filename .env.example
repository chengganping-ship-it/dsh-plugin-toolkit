# Hive Protocol Agent 配置
# 复制此文件为 .env 并填写你的配置

# Hive Protocol API Key（从 https://uphive.xyz/agent/register 获取）
HIVE_API_KEY=

# Solana 钱包地址（用于接收USDC付款）
# 可以从 Phantom/Solflare 钱包获取
SOLANA_WALLET_ADDRESS=

# Agent 配置
AGENT_NAME=AutoCoderAgent

# 运行模式: once | loop
RUN_MODE=loop

# 扫描间隔（分钟）
SCAN_INTERVAL=30

# LLM API 配置（用于执行任务）
# 支持 OpenAI/Anthropic/DeepSeek 等
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
