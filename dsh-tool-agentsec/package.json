{
  "name": "dsh-tool-agentsec",
  "version": "0.1.0",
  "description": "AI Agent Security & Prompt Injection Defense for DeepSeek Harness - Prompt injection detection, jailbreak prevention, output filtering, agent sandboxing, tool use monitoring, data exfiltration guard, privilege escalation detection, and adversarial robustness scoring",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-tool-agentsec.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-security",
    "prompt-injection",
    "jailbreak-prevention",
    "output-filtering",
    "agent-sandboxing",
    "tool-use-monitor",
    "data-exfiltration",
    "privilege-escalation",
    "adversarial-robustness",
    "ai-agent-security",
    "llm-security"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "dsh-plugins"
}
