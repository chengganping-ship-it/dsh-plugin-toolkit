{
  "name": "dsh-tool-realestateai",
  "version": "0.1.0",
  "description": "AI Real Estate Agent for DeepSeek Harness - Property valuation, investment analysis, market forecasting, mortgage assessment, property management, rental yield optimization, neighborhood scoring, ESG compliance",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realestateai/dsh-tool-realestateai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "real-estate",
    "property",
    "valuation",
    "investment",
    "mortgage",
    "rental",
    "esg",
    "market-forecast",
    "property-management"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "realestateai"
}
