{
  "name": "dsh-tool-pragent",
  "version": "0.1.0",
  "description": "AI Public Relations & Media Relations Toolkit for DeepSeek Harness - Media relations management, press release writing, crisis communications, thought leadership, award submissions, social proof amplification, media measurement, and content distribution optimization",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-pragent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pr",
    "media-relations",
    "communications",
    "press",
    "public-relations",
    "crisis-comms",
    "thought-leadership",
    "press-release",
    "award-submission",
    "social-proof",
    "media-measurement",
    "content-distribution"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
