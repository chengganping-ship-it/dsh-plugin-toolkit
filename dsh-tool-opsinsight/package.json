{
  "name": "dsh-tool-opsinsight",
  "version": "0.1.0",
  "description": "AIOps Observability Toolkit for DeepSeek Harness - Alert fusion, root cause analysis, auto-remediation, capacity planning, log insight, SLO guardian, chaos engineering, and team health monitoring. Dark-theme monitoring with real-time status panels and Mermaid-style topology visualization.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-opsinsight.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "aiops",
    "observability",
    "monitoring",
    "devops",
    "sre",
    "alerting",
    "root-cause-analysis",
    "auto-remediation",
    "capacity-planning",
    "log-analysis",
    "slo",
    "chaos-engineering",
    "incident-management",
    "topology",
    "mttr",
    "pagerduty",
    "prometheus",
    "datadog"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
