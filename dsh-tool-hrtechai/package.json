{
  "name": "dsh-tool-hrtechai",
  "version": "0.1.0",
  "description": "HR Technology & People Analytics AI Agent Plugin for DSH - employee engagement, performance management, workforce planning, compensation analysis, talent acquisition, retention risk, L&D planning, DEI metrics",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-hrtechai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "hr",
    "hrtech",
    "people-analytics",
    "employee-engagement",
    "performance-management",
    "workforce-planning",
    "compensation",
    "talent-acquisition",
    "retention",
    "learning-development",
    "dei",
    "diversity-equity-inclusion"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
