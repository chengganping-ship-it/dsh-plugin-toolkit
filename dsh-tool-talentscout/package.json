{
  "name": "dsh-tool-talentscout",
  "version": "0.1.0",
  "description": "Talent Acquisition & Recruitment AI plugin for DSH - candidate sourcing, interview automation, skills assessment, employer branding, talent pipeline, compensation benchmarking, diversity sourcing, recruitment ROI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-talentscout.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "talent",
    "recruitment",
    "sourcing",
    "interview",
    "skills",
    "employer-branding",
    "pipeline",
    "compensation",
    "diversity",
    "roi"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
