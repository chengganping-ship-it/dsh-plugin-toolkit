{
  "name": "dsh-tool-defiscanner",
  "version": "0.1.0",
  "description": "DeFi Protocol Security Scanner for DeepSeek Harness - Smart contract vulnerability scanning, flash loan attack detection, oracle risk assessment, governance attack analysis, composability risk scoring, TVL health monitoring, tokenomics audit, and rugpull signal detection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-defiscanner.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "defi",
    "security",
    "smart-contract",
    "vulnerability",
    "flash-loan",
    "oracle",
    "governance",
    "audit",
    "rugpull",
    "risk-assessment"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
