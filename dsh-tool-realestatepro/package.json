{
  "name": "dsh-tool-realestatepro",
  "version": "1.0.0",
  "description": "Real Estate Pro Investment & Property Management Agent for DeepSeek Harness - Advanced property valuation with multi-model approach, investment return analysis, tenant screening, property management orchestration, market trend compass, financing optimization, location risk assessment, and portfolio construction",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-realestatepro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "real-estate",
    "property",
    "investment",
    "valuation",
    "property-management",
    "tenant-screening",
    "portfolio",
    "financing",
    "market-analysis",
    "risk-assessment",
    "rental-yield",
    "cap-rate",
    "cash-flow"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
