    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-socialagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "social-media",
    "marketing",
    "community",
    "content-creation",
    "social-media-automation",
    "content-calendar",
    "influencer-marketing",
    "hashtag-optimization",
    "community-management",
    "competitive-intelligence",
    "crisis-detection",
    "roi-analytics",
    "ab-testing"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
