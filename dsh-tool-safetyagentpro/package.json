{
  "name": "dsh-tool-safetyagentpro",
  "version": "0.1.0",
  "description": "Public Safety AI Assistant for DeepSeek Harness - Crime hotspot analysis, emergency dispatch optimization, disaster loss estimation, crowd safety monitoring, fire safety inspection, traffic safety analytics, food and drug safety compliance, and urban resilience planning",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-safetyagentpro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "public-safety",
    "emergency-management",
    "crime-analysis",
    "disaster-response",
    "crowd-safety",
    "fire-safety",
    "traffic-safety",
    "food-safety",
    "resilience",
    "urban-planning",
    "ai-agents"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
