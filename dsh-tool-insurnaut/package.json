{
  "name": "dsh-tool-insurnaut",
  "version": "0.1.0",
  "description": "Insurance Navigator for DeepSeek Harness - Claims analysis, underwriting advisor, coverage optimizer, risk assessor, policy comparator, premium calculator, fraud detector, and regulatory compliance",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-insurnaut.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "insurance",
    "claims-analysis",
    "underwriting",
    "coverage-optimization",
    "risk-assessment",
    "policy-comparison",
    "premium-calculation",
    "fraud-detection",
    "regulatory-compliance",
    "insurtech"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
