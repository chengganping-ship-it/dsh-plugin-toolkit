{
  "name": "dsh-tool-supplyrisk",
  "version": "0.1.0",
  "description": "Supply Chain Risk Early Warning System for DeepSeek Harness - Supplier health scoring, geopolitical risk mapping, disruption early warning, alternative supplier finding, logistics bottleneck detection, cost volatility tracking, single-source detection, and supply chain resilience scoring",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-supplyrisk.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "supply-chain",
    "risk-management",
    "supplier-health",
    "geopolitical-risk",
    "logistics",
    "resilience",
    "procurement",
    "early-warning"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
