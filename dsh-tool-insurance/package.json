{
  "name": "dsh-tool-insurance",
  "version": "0.1.0",
  "description": "Insurance Actuarial Engine for DeepSeek Harness - Premium calculation, claims prediction, risk scoring, reserving analysis, fraud detection, catastrophe modeling, life table analysis, and reinsurance optimization",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-insurance.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "insurance",
    "actuarial",
    "premium",
    "claims",
    "risk-scoring",
    "reserving",
    "fraud-detection",
    "catastrophe",
    "life-table",
    "reinsurance"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
