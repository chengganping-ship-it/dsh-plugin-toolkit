{
  "name": "dsh-tool-edutech",
  "version": "0.1.0",
  "description": "EdTech Intelligence Plugin for DeepSeek Harness - Curriculum design, learning outcome prediction, student risk identification, educational content optimization, assessment generation, personalized learning paths, engagement analysis, and knowledge gap detection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-edutech.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "edtech",
    "education",
    "curriculum",
    "learning",
    "assessment",
    "student-risk",
    "personalized-learning",
    "engagement",
    "knowledge-gap",
    "content-quality"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
