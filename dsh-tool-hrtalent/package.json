{
  "name": "dsh-tool-hrtalent",
  "version": "0.1.0",
  "description": "HR & Talent Intelligence Plugin for DeepSeek Harness - Resume screening, salary benchmarking, employee engagement scoring, turnover prediction, workforce planning, performance analysis, diversity analytics, and learning recommendations",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-hrtalent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "hr",
    "talent",
    "recruitment",
    "resume",
    "salary",
    "benchmarking",
    "engagement",
    "turnover",
    "workforce",
    "performance",
    "diversity",
    "learning",
    "people-analytics",
    "human-resources"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
