{
  "name": "dsh-tool-musicprodagent",
  "version": "0.1.0",
  "description": "Music production AI agent for DSH - chord progressions, melody composition, mixing, mastering, sample organization, copyright checking, arrangement, AI music generation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-musicprodagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "music-production",
    "chord-progression",
    "melody-composition",
    "mixing",
    "mastering",
    "sample-library",
    "copyright-check",
    "arrangement",
    "ai-music-generation"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
