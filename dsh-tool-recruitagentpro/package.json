{
  "name": "dsh-tool-recruitagentpro",
  "version": "0.1.0",
  "description": "Recruitment AI agent plugin for DSH - resume parsing, candidate matching, interview scheduling, talent pool analysis, JD optimization, offer comparison, sourcing strategy, diversity metrics",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-recruitagentpro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "recruitment",
    "hiring",
    "resume",
    "candidate",
    "interview",
    "talent",
    "ats",
    "diversity"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
