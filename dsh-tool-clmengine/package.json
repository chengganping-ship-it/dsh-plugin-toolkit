{
  "name": "dsh-tool-clmengine",
  "version": "0.1.0",
  "description": "Contract Lifecycle Management (CLM) Engine for DeepSeek Harness - AI-powered contract drafting, negotiation, obligation tracking, renewal management, analysis, AI clause negotiation, signature orchestration, and compliance verification. Inspired by TermScout 2026 contract signals and Icertis CLM.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-clmengine.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ai-agent",
    "cordis",
    "contract",
    "legal",
    "clm",
    "contract-lifecycle",
    "contract-management",
    "legaltech",
    "contract-drafting",
    "negotiation",
    "compliance",
    "obligations",
    "renewal",
    "e-signature",
    "ai-clause",
    "nda"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
