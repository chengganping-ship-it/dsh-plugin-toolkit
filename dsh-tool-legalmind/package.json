{
  "name": "dsh-tool-legalmind",
  "version": "0.1.0",
  "description": "Legal Document Intelligence plugin for DeepSeek Harness - Contract clause extraction, obligation tracking, legal risk scoring, NDA analysis, employment contract review, SLA evaluation, lease analysis, and merger clause detection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-legalmind.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "legal",
    "contract",
    "clause-extraction",
    "obligation-tracking",
    "risk-assessment",
    "nda",
    "employment",
    "sla",
    "lease",
    "merger-clause",
    "legal-intelligence"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
