{
  "name": "dsh-tool-travelplanner",
  "version": "0.1.0",
  "description": "Intelligent Travel Planner for DeepSeek Harness - Multi-source coordination, itinerary optimization, budget planning, booking strategy, calendar coordination, local discovery, contingency planning, travel document checking, and carbon footprint calculation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-travelplanner.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "travel",
    "itinerary",
    "budget",
    "booking",
    "calendar",
    "carbon-footprint",
    "contingency",
    "local-discovery",
    "travel-documents"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
