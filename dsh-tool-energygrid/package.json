{
  "name": "dsh-tool-energygrid",
  "version": "0.1.0",
  "description": "Energy Grid & Utilities for DeepSeek Harness - Grid optimization, demand forecasting, renewable integration, energy trading, outage management, power quality, energy storage, utility bill analysis",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https.com/dsh-tool-energygrid.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "smart-grid",
    "energy-management",
    "grid-optimization",
    "demand-forecasting",
    "renewable-integration",
    "energy-trading",
    "outage-management",
    "power-quality",
    "energy-storage",
    "utility-bill"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
