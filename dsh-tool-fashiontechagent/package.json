{
  "name": "dsh-tool-fashiontechagent",
  "version": "0.1.0",
  "description": "Fashion technology AI agent for DSH - trend forecasting, style recommendation, virtual try-on, inventory optimization, sustainability audit, dynamic pricing, show planning, and influencer matching",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-fashiontechagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "fashion",
    "trend-forecasting",
    "style-recommendation",
    "virtual-tryon",
    "inventory-optimization",
    "sustainability",
    "dynamic-pricing",
    "fashion-show",
    "influencer-marketing"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
