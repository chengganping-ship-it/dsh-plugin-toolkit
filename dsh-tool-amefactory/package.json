{
  "name": "dsh-tool-amefactory",
  "version": "0.1.0",
  "description": "AI Multi-modal Content Factory for DeepSeek Harness - Content generation, optimization, and repurposing toolkit. Content briefs, image prompts, video scripts, social media optimization, SEO scoring, brand voice analysis, content calendars, and repurposing.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-amefactory.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "content-generation",
    "content-optimization",
    "image-prompts",
    "video-scripts",
    "social-media",
    "seo",
    "brand-voice",
    "content-calendar",
    "repurposing",
    "ai-content",
    "multimodal"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
