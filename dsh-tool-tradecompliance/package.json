{
  "name": "dsh-tool-tradecompliance",
  "version": "0.1.0",
  "description": "AI-driven Customs and Trade Compliance Plugin for DeepSeek Harness - HS code classification, duty calculation, restricted party screening, document automation, compliance auditing, FTA optimization, customs broker workflow, and trade regulation monitoring",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-tradecompliance.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "trade-compliance",
    "customs",
    "hs-code",
    "duty-calculation",
    "sanctions",
    "fta",
    "import-export",
    "restricted-party-screening",
    "certificate-of-origin"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
