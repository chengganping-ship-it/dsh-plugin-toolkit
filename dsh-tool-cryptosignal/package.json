{
  "name": "dsh-tool-cryptosignal",
  "version": "0.1.0",
  "description": "Crypto Arbitrage Signal Engine for DeepSeek Harness - Funding rate arbitrage detection, cross-exchange spread monitoring, whale movement tracking, liquidation heatmaps, volatility regime analysis, basis spread, and opportunity scoring",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-cryptosignal.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "crypto",
    "arbitrage",
    "funding-rate",
    "cross-exchange",
    "whale-tracking",
    "liquidation",
    "volatility",
    "basis-trade",
    "defi",
    "quant",
    "trading-signals"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
