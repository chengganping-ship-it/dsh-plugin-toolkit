{
  "name": "dsh-tool-governance",
  "version": "0.1.0",
  "description": "DeepSeek Harness Agent Security Governance Plugin - Permission Auditor, Compliance Checker, Guardrail Designer, Audit Trail Generator, Data Leak Detector, Tool Sandbox Scorer, Prompt Injection Detector, Governance Maturity Assessor",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
