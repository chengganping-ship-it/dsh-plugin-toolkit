            }
          ]
        }
      },
      "id": "changed",
      "name": "Content Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "text": "=\u26a0\ufe0f USITC Tariff page has been updated! Check for new regulations affecting your product categories.",
        "chatId": "YOUR_CHAT_ID"
      },
      "id": "alert",
      "name": "Send Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
