{
  "name": "dsh-tool-martech",
  "version": "0.1.0",
  "description": "Marketing Attribution & ROI Engine for DeepSeek Harness - Multi-touch attribution, channel ROI analysis, budget optimization, campaign forecasting, CAC analysis, funnel analysis, A/B testing, and marketing mix modeling",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-martech.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "marketing",
    "attribution",
    "roi",
    "budget-optimization",
    "campaign-forecasting",
    "cac",
    "funnel-analysis",
    "ab-testing",
    "marketing-mix",
    "analytics"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
