{
  "name": "dsh-tool-mlopsai",
  "version": "0.1.0",
  "description": "AI MLOps & AgentOps Toolkit for DeepSeek Harness - Model lifecycle management, experiment tracking, pipeline orchestration, model monitoring, drift detection, feature store configuration, data quality gating, and model card completion",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-mlopsai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mlops",
    "agentops",
    "ml",
    "ai",
    "model-management",
    "experiment-tracking",
    "pipeline",
    "monitoring",
    "drift-detection",
    "feature-store",
    "data-quality",
    "model-card"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
