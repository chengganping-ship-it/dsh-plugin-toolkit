{
  "name": "dsh-tool-qualityAI",
  "version": "0.1.0",
  "description": "Manufacturing Quality & Process Optimization for DeepSeek Harness - SPC analysis, defect prediction, root cause analysis, process capability calculation, Six Sigma project selection, inspection planning, supplier quality scoring, and cost of poor quality tracking",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-qualityAI.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "manufacturing",
    "quality",
    "spc",
    "statistical-process-control",
    "defect-prediction",
    "root-cause-analysis",
    "process-capability",
    "six-sigma",
    "inspection-planning",
    "supplier-quality",
    "cost-of-poor-quality",
    "smart-manufacturing",
    "industry-4.0"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
