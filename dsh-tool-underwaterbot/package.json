{
  "name": "dsh-tool-underwaterbot",
  "version": "0.1.0",
  "description": "Underwater Robotics & Marine Tech AI Agent for DeepSeek Harness - AUV mission planning, ROV operations, underwater inspection, marine data analysis, sonar signal processing, underwater communication, ocean sediment sampling, marine biodiversity monitoring",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underwaterbot/dsh-tool-underwaterbot.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "auv",
    "rov",
    "underwater",
    "marine",
    "ocean",
    "sonar",
    "biodiversity",
    "sediment",
    "inspection"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "underwaterbot"
}
