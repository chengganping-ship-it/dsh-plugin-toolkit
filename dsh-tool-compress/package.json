{
  "name": "dsh-tool-compress",
  "version": "0.1.0",
  "description": "LLM Token Compression & Optimization Engine for DeepSeek Harness - Prompt compression, context window management, semantic deduplication, summarization, embedding cache optimization, batch processing, and cost analysis",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-compress.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "llm",
    "token-compression",
    "prompt-engineering",
    "context-optimization",
    "cost-reduction",
    "embedding-cache",
    "batch-optimization",
    "summarization",
    "semantic-dedup"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
