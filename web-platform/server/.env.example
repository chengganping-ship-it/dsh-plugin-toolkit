# Funding Mirror Server Environment Variables
# Copy this to .env and fill in your values

# Server
NODE_ENV=production
PORT=8771

# Feature Flags (set to 'true' to enable)
# ENABLE_TELEGRAM_ALERTS=false

# External API Keys (optional, for enhanced features)
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Subscription API Key Salt (generate with: openssl rand -hex 32)
# API_KEY_SALT=
