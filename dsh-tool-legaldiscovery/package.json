{
  "name": "dsh-tool-legaldiscovery",
  "version": "0.1.0",
  "description": "eDiscovery Pro - electronic evidence collection, document review, concept clustering, privilege log analysis, redaction engine, production setter, review workflow monitor, dispute strategy",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-legaldiscovery.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ediscovery",
    "legal",
    "document-review",
    "ediscovery",
    "compliance",
    "privilege-log",
    "redaction",
    "production",
    "litigation",
    "document-clustering",
    "legal-tech",
    "e-discovery"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
