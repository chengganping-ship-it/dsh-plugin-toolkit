{
  "name": "dsh-tool-healthrcm",
  "version": "0.1.0",
  "description": "Healthcare Revenue Cycle Management (RCM) plugin for DeepSeek Harness - Eligibility verification, charge capture, medical coding, claims submission, denial management, patient billing, RCM analytics dashboard, and prior authorization engine",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-healthrcm.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "healthcare",
    "revenue-cycle",
    "rcm",
    "medical-billing",
    "coding",
    "claims",
    "denial-management",
    "prior-authorization",
    "eligibility",
    "charge-capture",
    "patient-billing",
    "healthcare-analytics"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
