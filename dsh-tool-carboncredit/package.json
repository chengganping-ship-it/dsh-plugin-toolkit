{
  "name": "dsh-tool-carboncredit",
  "version": "0.1.0",
  "description": "Carbon Credit & Offset Marketplace - Carbon credit verification, offset project evaluation, carbon footprint calculation, registry management. 2026: Voluntary carbon market projected to reach $50B by 2030; compliance markets exceed $900B globally.",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "carbon-credit",
    "carbon-offset",
    "voluntary-carbon-market",
    "carbon-footprint",
    "registry-management",
    "credit-verification",
    "offset-evaluation",
    "carbon-price",
    "carbon-neutrality"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "dsh-plugin-toolkit"
}
