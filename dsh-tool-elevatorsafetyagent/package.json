{
  "name": "dsh-tool-elevatorsafetyagent",
  "version": "0.1.0",
  "description": "Elevator & Special Equipment Safety AI Agent for DeepSeek Harness - Fault prediction, inspection scheduling, IoT monitoring, compliance management, modernization advisory, energy auditing, rescue simulation, and lifecycle cost analysis",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-elevatorsafetyagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "elevator",
    "special-equipment",
    "safety",
    "iot",
    "predictive-maintenance",
    "compliance",
    "rescue",
    "energy-efficiency",
    "ai-agents"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
