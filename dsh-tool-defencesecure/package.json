    "national-security",
    "c4isr",
    "threat-assessment",
    "cyber-defense",
    "intelligence-analysis",
    "autonomous-systems",
    "critical-infrastructure",
    "supply-chain-security",
    "strategic-forecasting",
    "classified-networks",
    "military-ai",
    "dual-use"
  ],
  "dependencies": {
