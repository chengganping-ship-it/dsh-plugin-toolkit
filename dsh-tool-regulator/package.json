{
  "name": "dsh-tool-regulator",
  "version": "0.1.0",
  "description": "Cross-Border Regulatory Compliance Radar for DeepSeek Harness - Policy change detection, compliance gap analysis, sanctions screening, tariff impact calculation, license requirement checking, deadline tracking, cross-border risk scoring, and regulation summarization",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-regulator.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "regulatory",
    "compliance",
    "cross-border",
    "sanctions",
    "tariff",
    "trade-policy",
    "e-commerce",
    "risk-assessment",
    "regulation"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
