{
  "name": "dsh-tool-learnedu",
  "version": "0.1.0",
  "description": "AI Education & Personalized Learning Plugin for DeepSeek Harness - Adaptive learning paths, knowledge assessment, content recommendation, progress tracking, skill gap identification, learning style detection, engagement optimization, and certification prep planning",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-learnedu.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "education",
    "edtech",
    "adaptive-learning",
    "personalized-learning",
    "knowledge-assessment",
    "content-recommendation",
    "progress-tracking",
    "skill-gap",
    "learning-style",
    "engagement-optimization",
    "certification-prep"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
