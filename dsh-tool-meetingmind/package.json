{
  "name": "dsh-tool-meetingmind",
  "version": "0.1.0",
  "description": "Meeting Intelligence Toolkit for DeepSeek Harness - Agenda design, realtime facilitation, decision intelligence, action tracking, knowledge harvesting, async meetings, analytics, and pre/post automation. Cyan efficiency theme with agenda templates and action tracker board.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-meetingmind.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "meeting",
    "productivity",
    "collaboration",
    "facilitation",
    "decisions",
    "agenda",
    "action-tracker",
    "realtime-facilitation",
    "async-meeting",
    "meeting-analytics",
    "knowledge-harvesting",
    "cyan-efficiency",
    "ai-meeting-assistant"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
