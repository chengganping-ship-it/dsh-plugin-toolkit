{
  "name": "dsh-tool-pharmaai",
  "version": "0.1.0",
  "description": "Pharmaceutical & Drug Discovery AI Agent for DeepSeek Harness - Clinical trial design, drug interaction checking, regulatory submission, pharmacovigilance, drug target identification, formulation optimization, bioequivalence analysis, patent landscape mapping",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-pharmaai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pharma",
    "pharmaceutical",
    "drug-discovery",
    "clinical-trial",
    "drug-interaction",
    "regulatory",
    "pharmacovigilance",
    "bioequivalence",
    "patent-landscape"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
