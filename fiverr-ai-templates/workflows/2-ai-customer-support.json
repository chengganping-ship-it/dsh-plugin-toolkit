{
  "name": "AI Customer Support Bot - Auto Reply & Route",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/support-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - New Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "你是一个专业的客户支持分类器。请分析以下客户消息，完成以下任务：\n\n1. **意图分类**（单选）：billing（账单）/ technical（技术）/ shipping（物流）/ general（一般）/ urgent（紧急）\n2. **情感评分**（1-10，10最正面）\n3. **自动回复草稿**：用友好、专业的语气写一封 100-200 字的回复草稿\n4. **是否需要人工**：true/false（如果情感评分<3 或意图=urgent，则 true）\n\n请严格按以下 JSON 格式输出：\n{\"intent\": \"...\", \"sentiment\": N, \"reply_draft\": \"...\", \"needs_human\": true/false}"
            },
            {
              "role": "user",
              "content": "客户消息: {{ $json.message }}\n客户邮箱: {{ $json.email }}\n订单号: {{ $json.order_id ?? 'N/A' }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 1000
        }
      },
      "id": "openai-classifier",
      "name": "GPT-4o Intent Classifier",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-human-needed",
              "leftValue": "={{ JSON.parse($json.choices[0].message.content).needs_human }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-decision",
      "name": "Needs Human?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "fromEmail": "support@yourdomain.com",
        "toEmail": "={{ $('Webhook - New Ticket').item.json.email }}",
        "subject": "Re: 您的客服工单 #{{ $('Webhook - New Ticket').item.json.ticket_id ?? 'NEW' }}",
        "text": "={{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).reply_draft }}",
        "options": {}
      },
      "id": "send-auto-reply",
      "name": "Send Auto Reply",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [850, 200],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Support Tickets",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}",
            "Email": "={{ $('Webhook - New Ticket').item.json.email }}",
            "Intent": "={{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).intent }}",
            "Sentiment": "={{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).sentiment }}",
            "Auto_Replied": "Yes",
            "Needs_Human": "No"
          }
        },
        "options": {}
      },
      "id": "log-auto-resolved",
      "name": "Log Auto-Resolved",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [1050, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "🚨 需要人工介入！\n\n客户: {{ $('Webhook - New Ticket').item.json.email }}\n意图: {{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).intent }}\n情感评分: {{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).sentiment }}/10\n\n消息内容:\n{{ $('Webhook - New Ticket').item.json.message }}",
        "additionalFields": {}
      },
      "id": "alert-human",
      "name": "Alert Human via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [850, 400],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Support Tickets",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}",
            "Email": "={{ $('Webhook - New Ticket').item.json.email }}",
            "Intent": "={{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).intent }}",
            "Sentiment": "={{ JSON.parse($('GPT-4o Intent Classifier').item.json.choices[0].message.content).sentiment }}",
            "Auto_Replied": "No",
            "Needs_Human": "Yes - Alerted"
          }
        },
        "options": {}
      },
      "id": "log-escalated",
      "name": "Log Escalated",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [1050, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    }
  ],
  "connections": {
    "Webhook - New Ticket": {
      "main": [
        [
          {
            "node": "GPT-4o Intent Classifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GPT-4o Intent Classifier": {
      "main": [
        [
          {
            "node": "Needs Human?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Human?": {
      "main": [
        [
          {
            "node": "Send Auto Reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Human via Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Auto Reply": {
      "main": [
        [
          {
            "node": "Log Auto-Resolved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Human via Telegram": {
      "main": [
        [
          {
            "node": "Log Escalated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "name": "AI Support",
      "entityType": "workflow"
    }
  ],
  "triggerCount": 1,
  "updatedAt": "2026-08-25T10:00:00.000Z",
  "versionId": "1"
}
