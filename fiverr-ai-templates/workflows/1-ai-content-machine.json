{
  "name": "AI Content Machine - RSS to Blog/Social",
  "nodes": [
    {
      "parameters": {
        "url": "https://feeds.feedburner.com/venturebeat/SZYF",
        "options": {}
      },
      "id": "rss-trigger",
      "name": "RSS Feed Trigger",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "filter-new-only",
              "leftValue": "={{ $json.pubDate }}",
              "rightValue": "={{ $now.minusHours(24).toISO() }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-node",
      "name": "Filter Last 24h",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "你是一个专业的内容编辑。请根据以下 RSS 文章生成：1) 一篇 300 字的中文摘要，2) 5 个 Twitter/X 帖子草稿（每个不超过 280 字符），3) 一个 LinkedIn 帖子草稿（不超过 1300 字符）。使用清晰的 markdown 格式输出。"
            },
            {
              "role": "user",
              "content": "标题: {{ $json.title }}\n链接: {{ $json.link }}\n内容: {{ $json['content:encoded'] ?? $json.content }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 2000
        }
      },
      "id": "openai-chat",
      "name": "GPT-4o Content Generator",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_DOC_ID",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Generated Content",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "Source": "={{ $('RSS Feed Trigger').item.json.title }}",
            "Summary": "={{ $json.choices[0].message.content }}",
            "Link": "={{ $('RSS Feed Trigger').item.json.link }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [850, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "sessionIdType": "customKey",
        "sessionKey": "content-bot",
        "text": "🆕 新内容已生成\n来源: {{ $('RSS Feed Trigger').item.json.title }}\n摘要: {{ $json.choices[0].message.content.slice(0, 200) }}...\n📊 已记录到 Google Sheets",
        "additionalFields": {}
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [850, 400],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "RSS Feed Trigger": {
      "main": [
        [
          {
            "node": "Filter Last 24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Last 24h": {
      "main": [
        [
          {
            "node": "GPT-4o Content Generator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GPT-4o Content Generator": {
      "main": [
        [
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Shanghai",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "name": "AI Content",
      "entityType": "workflow"
    }
  ],
  "triggerCount": 1,
  "updatedAt": "2026-08-25T10:00:00.000Z",
  "versionId": "1"
}
