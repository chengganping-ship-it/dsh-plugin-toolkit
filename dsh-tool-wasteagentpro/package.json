{
  "name": "dsh-tool-wasteagentpro",
  "version": "0.1.0",
  "description": "Solid Waste Management AI Agent for DeepSeek Harness - Waste composition analysis, recycling route optimization, landfill operation management, waste-to-energy planning, hazardous waste tracking, circular economy mapping, smart bin monitoring, and waste carbon credit accounting",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-wasteagentpro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "waste-management",
    "solid-waste",
    "recycling",
    "landfill",
    "waste-to-energy",
    "hazardous-waste",
    "circular-economy",
    "smart-bin",
    "carbon-credit",
    "ccer",
    "leachate",
    "biogas"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
