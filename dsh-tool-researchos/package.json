{
  "name": "dsh-tool-researchos",
  "version": "0.1.0",
  "description": "ResearchOS - AI Scientist toolkit for academic research acceleration. Intelligent literature review, hypothesis generation, experiment design, data pipeline management, paper outlining, peer review simulation, research trend radar, and collaboration/funding recommendations.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-researchos.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "research",
    "science",
    "academic",
    "paper",
    "experiment",
    "ai-scientist",
    "literature-review",
    "hypothesis",
    "peer-review",
    "funding",
    "collaboration"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
