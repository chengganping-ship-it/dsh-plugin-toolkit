{
  "name": "dsh-tool-medagent",
  "version": "0.1.0",
  "description": "Medical AI Agent for DeepSeek Harness - Clinical decision support, EHR coding, quality control, drug safety, lab interpretation, treatment pathways, patient risk stratification, and medical documentation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-medagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "medical-ai",
    "clinical-decision-support",
    "ehr-coding",
    "drug-safety",
    "healthcare",
    "medical-documentation",
    "patient-risk"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
