    "creator-economy",
    "campaign-management",
    "roi-forecasting",
    "compliance",
    "crisis-management",
    "community-engagement",
    "brand-safety"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
