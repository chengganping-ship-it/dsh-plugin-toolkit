{
  "name": "dsh-tool-reach",
  "version": "0.1.0",
  "description": "Agent Web Intelligence Engine for DeepSeek Harness - Content extraction, social media monitoring, news aggregation, competitor intelligence, SEO analysis, forum sentiment, documentation scraping, and trend forecasting",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-reach.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-intelligence",
    "content-extraction",
    "social-media",
    "news-aggregator",
    "competitor-intel",
    "seo",
    "sentiment-analysis",
    "trend-forecast",
    "agent-reach",
    "web-scraping"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
