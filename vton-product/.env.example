"""
虚拟试穿 SaaS - 环境变量配置模板
复制为 .env 并填入真实 API Key 即可激活云端服务
"""

# ===== 推理引擎选择 =====
# mock=本地贴图(无需API) / cloud=云端真模型
VTON_BACKEND=cloud

# ===== 云端 API Key（Google 登录即可注册）=====

# fal.ai - https://fal.ai (免费额度, Google 登录)
# 支持: VTON / SDXL / Flux / 模特生成 / 换装
FAL_KEY=

# Replicate - https://replicate.com (需信用卡验证但不扣费)
# 支持: IDM-VTON / 模特 / 风格化
REPLICATE_API_TOKEN=

# SiliconFlow 国际站 - https://siliconflow.cn (支持 Google 登录, 免费 ￥7)
# 支持: SDXL / 图生图 / 中文场景
SILICONFLOW_API_KEY=

# ===== 语音 / 视频 =====

# ElevenLabs - https://elevenlabs.io (免费 1万字符/月, Google 登录)
ELEVENLABS_API_KEY=

# 即梦数字人 (需手机号注册, 有免费额度)
JIMENG_API_KEY=

# ===== LLM 文案 =====

# DeepSeek - https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# SiliconFlow 的 DeepSeek (国际站可调用)
# DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1

# ===== 支付 =====

# 微信支付 (正式商户号)
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# 支付宝 (沙箱/正式)
ALIPAY_APP_ID=

# ===== 站点 =====
SITE_URL=http://localhost:8000
