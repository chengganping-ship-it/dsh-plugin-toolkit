{
  "name": "dsh-tool-insurtechai",
  "version": "0.1.0",
  "description": "AI Insurance (InsurTech) Engine for DeepSeek Harness - Underwriting, claims processing, fraud detection, risk assessment, policy recommendation, actuarial pricing, customer lifetime value prediction, and regulatory compliance checking",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-insurtechai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "insurance",
    "insurtech",
    "underwriting",
    "claims",
    "fraud-detection",
    "risk-assessment",
    "actuarial",
    "compliance"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
