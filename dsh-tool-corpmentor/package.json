{
  "name": "dsh-tool-corpmentor",
  "version": "0.1.0",
  "description": "Corporate Training & L&D Toolkit for DeepSeek Harness - Learning pathway design, compliance training, skill development, knowledge retention, mentoring programs, training ROI, microlearning, and leadership development coaching",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-corpmentor.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "corporate-training",
    "learning-development",
    "compliance-training",
    "skill-development",
    "knowledge-retention",
    "mentoring",
    "microlearning",
    "leadership-development",
    "training-roi",
    "enterprise-learning"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
