{
  "name": "dsh-tool-esgscore",
  "version": "0.1.0",
  "description": "ESG Supply Chain Scorer for DeepSeek Harness - Carbon footprint calculation, labor practice scoring, governance compliance, supply chain transparency, ESG risk heatmap, sustainability report generation, stakeholder impact assessment, and ESG benchmarking",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-esgscore.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "esg",
    "sustainability",
    "carbon-footprint",
    "supply-chain",
    "labor-practices",
    "governance",
    "risk-assessment",
    "sustainability-report",
    "stakeholder",
    "benchmarking"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  }
}
