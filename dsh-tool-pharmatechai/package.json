{
  "name": "dsh-tool-pharmatechai",
  "version": "0.1.0",
  "description": "AI Pharma and Drug Discovery plugin for DeepSeek Harness - Target identification, molecular design, clinical trial optimization, drug safety prediction, biomarker discovery, formulation optimization, regulatory submission advisory, and drug repositioning",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-pharmatechai.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pharma",
    "drug-discovery",
    "target-identification",
    "molecular-design",
    "clinical-trials",
    "drug-safety",
    "biomarker",
    "formulation",
    "regulatory",
    "drug-repositioning"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
