{
  "name": "dsh-tool-predict",
  "version": "0.1.0",
  "description": "Predictive Analytics Engine for DeepSeek Harness - Time series forecasting, trend prediction, anomaly detection, demand forecasting, churn prediction, revenue projection, risk scoring, and scenario simulation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-predict.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "predictive-analytics",
    "time-series",
    "forecasting",
    "trend-analysis",
    "anomaly-detection",
    "demand-forecasting",
    "churn-prediction",
    "revenue-projection",
    "risk-scoring",
    "scenario-simulation",
    "statistics",
    "machine-learning"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
