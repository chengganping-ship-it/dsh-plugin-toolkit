{
  "name": "dsh-tool-bioinformatics",
  "version": "0.1.0",
  "description": "Bioinformatics & Genomics Toolkit for DeepSeek Harness - Sequence analysis, genome annotation, protein structure prediction, CRISPR guide design, single-cell RNA-seq, phylogenetics, metagenomics profiling, and synthetic biology circuit design",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-bioinformatics.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bioinformatics",
    "genomics",
    "proteomics",
    "crispr",
    "synthetic-biology",
    "sequence-alignment",
    "genome-annotation",
    "protein-structure",
    "single-cell-rnaseq",
    "phylogenetics",
    "metagenomics",
    "biology"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
