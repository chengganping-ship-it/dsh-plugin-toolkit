{
  "name": "dsh-tool-cyberthreat",
  "version": "0.1.0",
  "description": "Cybersecurity & Threat Intelligence Plugin for DeepSeek Harness - threat detection, vulnerability management, incident response, security orchestration, attack surface mapping, malware analysis, security posture scoring, and zero trust architecture advice",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-tool-cyberthreat.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cybersecurity",
    "threat-intelligence",
    "vulnerability-management",
    "incident-response",
    "security-orchestration",
    "attack-surface",
    "malware-analysis",
    "zero-trust",
    "security-posture"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "dsh-plugins"
}
