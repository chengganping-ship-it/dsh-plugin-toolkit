  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "api",
    "monetization",
    "rate-limiting",
    "developer-experience",
    "api-management",
    "graphql",
    "api-security",
    "api-analytics",
    "api-portfolio"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
