{
  "name": "dsh-tool-insuranceclaim",
  "version": "0.1.0",
  "description": "Insurance Claims Automation for DeepSeek Harness - First notice reporting, loss assessment, coverage verification, fraud detection, settlement negotiation, recovery tracking, claims analytics, and customer claim portal",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-insuranceclaim.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "insurance",
    "claims",
    "adjustment",
    "fraud-detection",
    "claims-automation",
    "loss-assessment",
    "coverage-verification",
    "settlement",
    "subrogation",
    "recovery",
    "insurtech",
    "claim-portal"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
