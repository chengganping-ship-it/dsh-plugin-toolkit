{
  "name": "dsh-tool-pragentpro",
  "version": "0.1.0",
  "description": "AI Media Publicity & PR Pro Toolkit for DeepSeek Harness - Press release distribution, media relations tracking, KOL strategy, brand sentiment monitoring, content amplification, campaign effectiveness, editorial calendar planning, and influencer ROI calculation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-pragentpro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pr",
    "media-relations",
    "press-release",
    "kol",
    "influencer",
    "sentiment",
    "editorial-calendar",
    "roi",
    "publicity",
    "communications"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
