{
  "name": "dsh-tool-memory",
  "version": "0.1.0",
  "description": "Agent Memory Management System for DeepSeek Harness - Persistent cross-session memory, context recall, and intelligent token optimization with 95.2% recall and 92% token savings",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-memory.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-memory",
    "memory-management",
    "context-recall",
    "token-optimization",
    "persistent-memory",
    "knowledge-graph",
    "ai-agent",
    "memory-compression",
    "context-assembly"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
