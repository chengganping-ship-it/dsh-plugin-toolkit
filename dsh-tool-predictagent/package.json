{
  "name": "dsh-tool-predictagent",
  "version": "0.1.0",
  "description": "AI Enterprise Prediction & Decision Intelligence Agent for DeepSeek Harness - Advanced demand forecasting, financial modeling, scenario planning, predictive maintenance, customer churn prediction, supply chain simulation, credit risk scoring, and market sizing with confidence intervals, tornado charts, and forecast vs actual visualization",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-predictagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "forecasting",
    "predictive-analytics",
    "financial-modeling",
    "scenario-planning",
    "predictive-maintenance",
    "customer-churn",
    "supply-chain",
    "credit-risk",
    "market-sizing",
    "decision-intelligence",
    "monte-carlo",
    "confidence-intervals",
    "tornado-chart"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
