{
  "name": "dsh-tool-fintechrisk",
  "version": "0.1.0",
  "description": "FinTech Risk Management Toolkit for DeepSeek Harness - Credit scoring, fraud detection, AML/KYC monitoring, market risk VaR, regulatory capital calculation, stress testing, AI transaction monitoring, and DeFi protocol risk auditing",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-fintechrisk.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "fintech",
    "risk-management",
    "credit-scoring",
    "fraud-detection",
    "aml",
    "kyc",
    "market-risk",
    "var",
    "regulatory-capital",
    "basel",
    "stress-testing",
    "transaction-monitoring",
    "defi",
    "protocol-risk"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
