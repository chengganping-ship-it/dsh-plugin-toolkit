{
  "name": "dsh-tool-precisionmed",
  "version": "0.1.0",
  "description": "Precision Medicine & Genomics Toolkit for DeepSeek Harness - Genomic variant analysis, pharmacogenomics, gene therapy design, biomarker discovery, CRISPR off-target prediction, liquid biopsy analysis, multi-omics integration, and clinical genomics reporting",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-precisionmed.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "precision-medicine",
    "genomics",
    "pharmacogenomics",
    "gene-therapy",
    "biomarker",
    "crispr",
    "liquid-biopsy",
    "multi-omics",
    "clinical-genomics",
    "variant-analysis",
    "biology"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
