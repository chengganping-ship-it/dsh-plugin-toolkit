# ================================================================
# Prediction Market Arbitrage Engine - Configuration
# Copy this to .env and fill in your values
# ================================================================

# === Polymarket (Polygon) ===
# Your Ethereum wallet private key (keep this SECRET)
POLYMARKET_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
POLYMARKET_CHAIN_ID=137

# === Kalshi (CFTC Regulated) ===
# Get from: https://kalshi.com/account/api-keys
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
KALSHI_EMAIL=

# === LLM Configuration ===
# For news analysis. Recommended: DeepSeek (cheap, fast, capable)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx
MODEL_NAME=deepseek-chat

# Alternatives:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# MODEL_NAME=gpt-4o-mini

# === Risk Parameters ===
INITIAL_CAPITAL=1000
MAX_POSITION_SIZE_USD=500
MAX_DAILY_LOSS_USD=50
MAX_DRAWDOWN_PCT=0.15
MIN_EDGE_THRESHOLD=0.03
KELLY_FRACTION=0.25
MAX_CONCURRENT_POSITIONS=8

# === Engine Settings ===
TICK_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/arbitrage.db
