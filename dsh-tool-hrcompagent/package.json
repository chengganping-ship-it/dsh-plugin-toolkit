{
  "name": "dsh-tool-hrcompagent",
  "version": "0.1.0",
  "description": "HR Compensation & Benefits AI Agent Plugin for DSH - salary benchmarking, total rewards, pay equity, incentive simulation, compensation banding, benefits optimization, executive comp, global payroll compliance",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengganping-ship-it/dsh-tool-hrcompagent.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "hr",
    "compensation",
    "benefits",
    "salary",
    "payroll",
    "pay-equity",
    "executive-comp",
    "total-rewards",
    "global-payroll",
    "incentives"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "chengganping-ship-it"
}
