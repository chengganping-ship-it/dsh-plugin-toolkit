{
  "name": "dsh-tool-carboncapt",
  "version": "0.1.0",
  "description": "Carbon Capture & Storage (CCS) - capture technology selection, storage site assessment, monitoring, economics. 2026: CCS market $15B+; direct air capture $5B+.",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "carbon-capture",
    "ccs",
    "co2-storage",
    "direct-air-capture",
    "carbon-sequestration",
    "co2-monitoring",
    "carbon-transport",
    "mineralization",
    "beccs",
    "carbon-storage"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dsh": {
    "bundle": "cordis.yml"
  },
  "author": "dsh-plugin-toolkit"
}
